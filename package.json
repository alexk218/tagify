{
  "name": "tagify-secret",
  "version": "2.5.0",
  "private": true,
  "exports": {
    "./components/ui": "./src/components/ui/index.ts",
    "./hooks/shared": "./src/hooks/shared/index.ts",
    "./features/*": "./src/features/*/index.ts",
    "./services/*": "./src/services/*.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "build": "spicetify-creator && node scripts/build/copy-version-metadata.cjs",
    "watch": "spicetify-creator --watch",
    "test": "npm run test:core",
    "test:watch": "vitest src/features/tag-data/utils/__tests__ src/features/smart-playlists/utils/__tests__ src/features/track-session/utils/__tests__ src/features/multi-track-tagging/utils/__tests__ src/features/filter-state/hooks/__tests__ src/features/discovery-survey/hooks/__tests__ src/features/power-user/hooks/__tests__ src/features/update-check/hooks/__tests__",
    "test:ui": "vitest --ui src/features/tag-data/utils/__tests__ src/features/smart-playlists/utils/__tests__ src/features/track-session/utils/__tests__ src/features/multi-track-tagging/utils/__tests__ src/features/filter-state/hooks/__tests__ src/features/discovery-survey/hooks/__tests__ src/features/power-user/hooks/__tests__ src/features/update-check/hooks/__tests__",
    "test:all": "vitest run",
    "test:core": "vitest run src/features/tag-data/utils/__tests__ src/features/smart-playlists/utils/__tests__ src/features/track-session/utils/__tests__ src/features/multi-track-tagging/utils/__tests__ src/features/filter-state/hooks/__tests__ src/features/discovery-survey/hooks/__tests__ src/features/power-user/hooks/__tests__ src/features/update-check/hooks/__tests__"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "lucide-react": "^0.542.0",
    "prop-types": "^15.8.1",
    "protobufjs": "^8.7.2",
    "react-rating-stars-component": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.6.1",
    "eslint": "^9.26.0",
    "eslint-plugin-css-modules": "^2.12.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.1.0",
    "happy-dom": "^12.10.3",
    "jsdom": "^26.1.0",
    "spicetify-creator": "^1.0.17",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^1.6.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sass": "^1.77.8"
  }
}
